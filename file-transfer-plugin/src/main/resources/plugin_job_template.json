{
  "schemaVersion": 1,
  "source": {
    "plugin": "local",
    "identity": "source-local",
    "config": {
      "rootPath": ""
    }
  },
  "target": {
    "plugin": "local",
    "identity": "target-local",
    "config": {
      "rootPath": ""
    }
  },
  "selection": {
    "rootPath": "",
    "paths": [],
    "recursive": true,
    "includeGlobs": [],
    "excludeGlobs": [],
    "maxFiles": 100000
  },
  "mapping": {
    "targetRootPath": "",
    "preserveRelativePath": true
  },
  "policy": {
    "conflictPolicy": "FAIL",
    "checksumAlgorithm": "SHA-256",
    "sourceSuccessAction": "KEEP"
  },
  "runtime": {
    "concurrency": 4,
    "maxRetries": 3,
    "retryBackoffMillis": [1000, 5000, 15000],
    "chunkSizeBytes": 8388608,
    "checkpointIntervalMillis": 1000,
    "maxBytesPerSecond": 0
  },
  "timeZone": "UTC",
  "parameters": {}
